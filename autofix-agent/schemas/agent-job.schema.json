{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoFix Agent Job",
  "description": "Request body accepted by POST /api/jobs. Built entirely by n8n Workflow 03 from a claimed AGENT_PENDING incident plus the sanitized ticket context fetched via Workflow 05. The agent re-validates every field independently (see lib/validate-job.sh) rather than trusting this envelope just because it parsed as JSON.",
  "type": "object",
  "required": [
    "schemaVersion", "jobId", "incidentId", "jiraKey", "fingerprint",
    "branchName", "contextHash", "ticketContext"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "jobId": {
      "type": "string",
      "pattern": "^autofix-[0-9]+-[0-9]+$",
      "description": "autofix-<incidentId>-<attempt>, generated by n8n."
    },
    "incidentId": { "type": "integer", "minimum": 1 },
    "jiraKey": {
      "type": "string",
      "pattern": "^AUTO-[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "branchName": {
      "type": "string",
      "pattern": "^autofix/AUTO-[0-9]+$"
    },
    "contextHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ticketContext": {
      "type": "object",
      "required": [
        "summary", "service", "environment", "exceptionType",
        "normalizedMessage", "applicationFrame", "httpMethod",
        "requestPath", "stackTrace", "approvedAgentContext"
      ],
      "properties": {
        "summary": { "type": "string" },
        "service": { "type": "string" },
        "environment": { "type": "string" },
        "exceptionType": { "type": "string" },
        "normalizedMessage": { "type": "string" },
        "applicationFrame": { "type": "string" },
        "httpMethod": { "type": "string" },
        "requestPath": { "type": "string" },
        "stackTrace": { "type": "string" },
        "approvedAgentContext": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
