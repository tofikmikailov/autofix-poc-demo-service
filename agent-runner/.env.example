# Stage 6: Agent Runner configuration template.
#
# Copy this file to `agent-runner/.env` (gitignored) and fill in real
# values. `agent-runner/.env` must never be committed.
#
# JIRA_USER_EMAIL / JIRA_API_TOKEN should belong to a dedicated
# *read-only* Jira account/token (recommended name:
# autofix-agent-jira-reader) with only Browse project / View issues /
# View comments -- no create/edit/transition/admin permissions. Jira
# write operations (comment + transition to REVIEW) remain exclusively
# in n8n Workflow 04, using a separate credential.

JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_USER_EMAIL=change-me
JIRA_API_TOKEN=change-me
JIRA_PROJECT_KEY=AUTO

JIRA_CONNECT_TIMEOUT_SECONDS=5
JIRA_REQUEST_TIMEOUT_SECONDS=20
JIRA_MAX_RETRIES=3

# Repository / runtime configuration (see README.md "Stage 5" and
# "Stage 6" sections for details).
AUTOFIX_REPO=/path/to/autofix-poc-demo-service
AUTOFIX_BASE_BRANCH=main
AUTOFIX_ROOT=~/autofix-poc
N8N_RESULT_WEBHOOK_URL=http://localhost:5678/webhook/autofix/pr-ready

# Temporary feature flag (Stage 6 Section 25 backward compatibility).
# Must stay false: Jira tickets without a valid AUTOFIX_CONTEXT_V1 block
# are never processed via a PostgreSQL-only fallback.
ALLOW_LEGACY_DB_CONTEXT_FALLBACK=false
