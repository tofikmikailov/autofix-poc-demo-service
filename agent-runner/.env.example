# Stage 6B: Agent Runner configuration template.
#
# Copy this file to `agent-runner/.env` (gitignored) and fill in real
# values. `agent-runner/.env` must never be committed.
#
# Since Stage 6B, the Agent Runner holds NO Jira credential whatsoever --
# JIRA_BASE_URL / JIRA_USER_EMAIL / JIRA_API_TOKEN do not belong here.
# Jira credentials live only inside n8n (used by Workflow 04's comment +
# transition and Workflow 05's ticket-context lookup). The Agent Runner
# instead authenticates to n8n's local webhook using a separate,
# non-Jira shared secret -- rotating/revoking it never touches Jira.

# Local n8n webhook that returns a sanitized Jira ticket context
# (Workflow 05 -- "Get AutoFix Ticket Context"). This is the ONLY
# network call the runner makes to obtain task context.
N8N_TICKET_CONTEXT_WEBHOOK_URL=http://localhost:5678/webhook/autofix/ticket-context

# Shared secret between the Agent Runner and n8n's Workflow 05 (sent as
# the X-AutoFix-Runner-Token header). Generate with:
#   openssl rand -hex 32
# Must match infrastructure/.env's AUTOFIX_RUNNER_WEBHOOK_TOKEN exactly.
AUTOFIX_RUNNER_WEBHOOK_TOKEN=change-me

N8N_CONNECT_TIMEOUT_SECONDS=5
N8N_REQUEST_TIMEOUT_SECONDS=30
N8N_MAX_RETRIES=3

# Repository / runtime configuration (see README.md "Stage 5" and
# "Stage 6" sections for details).
AUTOFIX_REPO=/path/to/autofix-poc-demo-service
AUTOFIX_BASE_BRANCH=main
AUTOFIX_ROOT=~/autofix-poc
N8N_RESULT_WEBHOOK_URL=http://localhost:5678/webhook/autofix/pr-ready

# Temporary feature flag (Stage 6 Section 25 backward compatibility).
# Must stay false: Jira tickets without a valid AUTOFIX_CONTEXT_V1 block
# are never processed via a PostgreSQL-only fallback.
ALLOW_LEGACY_DB_CONTEXT_FALLBACK=false
