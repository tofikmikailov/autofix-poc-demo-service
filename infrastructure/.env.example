POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=generate-with-openssl

# Jira Cloud tenant base URL, read by n8n workflows via {{ $env.JIRA_BASE_URL }}
JIRA_BASE_URL=https://your-site.atlassian.net

# Stage 6B: shared local secret protecting the n8n "05 - Get AutoFix
# Ticket Context" webhook (infrastructure/n8n/workflows/05-get-autofix-ticket-context.json).
# This is NOT a Jira credential -- it only authenticates the local Agent
# Runner to this one webhook. Generate with: openssl rand -hex 32
AUTOFIX_RUNNER_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-32
