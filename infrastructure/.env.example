POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=generate-with-openssl

# Jira Cloud tenant base URL, read by n8n workflows via {{ $env.JIRA_BASE_URL }}
JIRA_BASE_URL=https://your-site.atlassian.net

# Stage 6B: shared local secret protecting the n8n "05 - Get AutoFix
# Ticket Context" webhook (infrastructure/n8n/workflows/05-get-autofix-ticket-context.json).
# This is NOT a Jira credential -- it only authenticates the local Agent
# Runner to this one webhook. Generate with: openssl rand -hex 32
AUTOFIX_RUNNER_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-32

# Stage 9: shared secret authenticating Logstash's push webhook call to
# Workflow 01 (POST /webhook/autofix/error-detected), validated by
# Workflow 01's "Validate Push Auth" node. Generate with:
# openssl rand -hex 32
AUTOFIX_LOGSTASH_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-32

# --- Containerized AutoFix Agent (autofix-agent) ----------------------------
# Bearer token n8n uses to call POST /api/jobs on the autofix-agent
# container. Generate with: openssl rand -hex 32
AUTOFIX_AGENT_API_TOKEN=generate-with-openssl-rand-hex-32

# Bearer token the autofix-agent container uses to call n8n's
# /webhook/autofix/agent-result callback. Generate with: openssl rand -hex 32
AUTOFIX_CALLBACK_TOKEN=generate-with-openssl-rand-hex-32

# Fixed target repository the autofix-agent container is allowed to
# clone/push to -- never accepted from the job request itself.
AUTOFIX_REPOSITORY_URL=https://github.com/tofikmikailov/autofix-poc-demo-service.git
AUTOFIX_REPOSITORY_OWNER=tofikmikailov
AUTOFIX_REPOSITORY_NAME=autofix-poc-demo-service
AUTOFIX_BASE_BRANCH=main

# GitHub CLI (gh) token used inside the agent container for git
# push/gh pr create -- a fine-grained PAT scoped to this repo only.
AUTOFIX_GITHUB_TOKEN=ghp_replace-me

# Copilot CLI auth token used inside the agent container
# (maps to COPILOT_GITHUB_TOKEN, see agent-runner CLI docs).
AUTOFIX_COPILOT_TOKEN=replace-me
