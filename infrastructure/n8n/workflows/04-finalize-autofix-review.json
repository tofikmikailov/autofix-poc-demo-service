      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const headers = $json.headers || {};\nconst body = $json.body || $json;\n\nconst expectedToken = $env.AUTOFIX_CALLBACK_TOKEN || '';\nconst authHeader = headers['authorization'] || '';\nconst receivedToken = authHeader.startsWith('Bearer ') ? authHeader.slice(7) : '';\n\nfunction timingSafeEqual(a, b) {\n  if (typeof a !== 'string' || typeof b !== 'string') return false;\n  if (a.length !== b.length) return false;\n  let diff = 0;\n  for (let i = 0; i < a.length; i++) {\n    diff |= a.charCodeAt(i) ^ b.charCodeAt(i);\n  }\n  return diff === 0;\n}\n\nconst tokenValid = expectedToken.length > 0 && timingSafeEqual(receivedToken, expectedToken);\n\nreturn { json: { tokenValid, body } };\n"
      },
      "typeVersion": 2
    },
