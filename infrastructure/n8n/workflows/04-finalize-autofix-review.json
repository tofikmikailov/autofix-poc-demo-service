      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body ?? $json;\n\nconst requiredFields = [\n  'incidentId', 'jiraKey', 'branchName', 'pullRequestNumber',\n  'pullRequestUrl', 'commitSha', 'testsPassed', 'changedFiles',\n  'addedLines', 'deletedLines',\n];\n\nconst errors = [];\nfor (const field of requiredFields) {\n  if (body[field] === undefined || body[field] === null || body[field] === '') {\n    errors.push(`missing field: ${field}`);\n  }\n}\n\nif (body.jiraKey !== undefined && typeof body.jiraKey !== 'string') {\n  errors.push('jiraKey must be a string');\n}\n\nreturn {\n  json: {\n    valid: errors.length === 0,\n    errors,\n    incidentId: body.incidentId,\n    jiraKey: body.jiraKey,\n    branchName: body.branchName,\n    pullRequestNumber: body.pullRequestNumber,\n    pullRequestUrl: body.pullRequestUrl,\n    commitSha: body.commitSha,\n    testsPassed: body.testsPassed,\n    changedFiles: body.changedFiles,\n    addedLines: body.addedLines,\n    deletedLines: body.deletedLines,\n    marker: body.jiraKey ? `[autofix-pr:${body.jiraKey}]` : null,\n  },\n};\n"
      },
      "typeVersion": 2
