      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "position": [
        -1280,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body;\n\nconst STATUSES = ['PR_READY', 'HUMAN_REQUIRED', 'AGENT_FAILED'];\nconst errors = [];\n\nconst commonFields = ['status', 'jobId', 'jiraKey', 'incidentId', 'contextHash'];\nfor (const field of commonFields) {\n  if (body[field] === undefined || body[field] === null || body[field] === '') {\n    errors.push(`missing field: ${field}`);\n  }\n}\nif (body.status !== undefined && !STATUSES.includes(body.status)) {\n  errors.push(`status must be one of ${STATUSES.join(', ')}`);\n}\n\nif (body.status === 'PR_READY') {\n  for (const field of ['prNumber', 'prUrl', 'commitSha', 'changedFiles', 'addedLines', 'deletedLines']) {\n    if (body[field] === undefined || body[field] === null || body[field] === '') {\n      errors.push(`missing PR_READY field: ${field}`);\n    }\n  }\n}\nif ((body.status === 'HUMAN_REQUIRED' || body.status === 'AGENT_FAILED') && !body.errorCode) {\n  errors.push('missing field: errorCode');\n}\n\nreturn {\n  json: {\n    valid: errors.length === 0,\n    errors,\n    status: body.status,\n    jobId: body.jobId,\n    jiraKey: body.jiraKey,\n    incidentId: Number(body.incidentId),\n    contextHash: body.contextHash,\n    prNumber: body.prNumber,\n    prUrl: body.prUrl,\n    commitSha: body.commitSha,\n    testsPassed: body.testsPassed,\n    changedFiles: body.changedFiles,\n    addedLines: body.addedLines,\n    deletedLines: body.deletedLines,\n    errorCode: body.errorCode,\n    errorMessage: body.errorMessage,\n    marker: body.jiraKey ? `[autofix-pr:${body.jiraKey}]` : null,\n  },\n};\n"
      },
      "typeVersion": 2
    },
