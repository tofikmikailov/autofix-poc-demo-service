    {
      "id": "n04-detect-marker",
      "name": "Detect AutoFix Comment Marker",
      "type": "n8n-nodes-base.code",
      "position": [
        80,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $('Validate Payload').first().json;\nconst marker = payload.marker;\n\nfunction extractText(node) {\n  if (!node) return '';\n  if (typeof node === 'string') return node;\n  let text = '';\n  if (node.type === 'text' && typeof node.text === 'string') {\n    text += node.text;\n  }\n  if (Array.isArray(node.content)) {\n    for (const child of node.content) {\n      text += extractText(child) + '\\n';\n    }\n  }\n  return text;\n}\n\nconst commentItems = $input.all();\nconst commentExists = commentItems.some((item) => {\n  const body = item.json.body;\n  const plainText = typeof body === 'string' ? body : extractText(body);\n  return plainText.includes(marker);\n});\n\nreturn {\n  json: {\n    ...payload,\n    commentExists,\n  },\n};\n"
      },
      "typeVersion": 2
    },
