      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $('Validate Payload').first().json;\nconst incident = $('Lookup Incident By Job ID').first().json;\nconst attempt = incident.agent_attempt_count;\n\nconst backoffByAttempt = { 1: '1 minute', 2: '5 minutes', 3: '15 minutes' };\nconst backoff = backoffByAttempt[attempt] || null;\nconst terminal = attempt >= 3;\nconst reason = `${payload.errorCode}: ${payload.errorMessage || ''} (attempt ${attempt})`;\n\nreturn {\n  json: {\n    incidentId: payload.incidentId,\n    terminal,\n    backoff,\n    reason,\n  },\n};\n"
      },
