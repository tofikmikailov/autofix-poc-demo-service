    {
      "id": "n04-evaluate-transition",
      "name": "Evaluate Jira Transition",
      "type": "n8n-nodes-base.code",
      "position": [
        1600,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const REVIEW_ALIASES = ['review', 'in review', 'code review', '\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430'];\n\nfunction isReviewName(name) {\n  return typeof name === 'string' && REVIEW_ALIASES.includes(name.trim().toLowerCase());\n}\n\nconst payload = $('Validate Payload').first().json;\nconst currentStatus = $('Get Jira Issue').first().json.fields.status;\n\nconst transitions = $input.all().map((item) => item.json);\nconst match = transitions.find(\n  (t) => isReviewName(t.name) || isReviewName(t.to && t.to.name)\n);\n\nreturn {\n  json: {\n    ...payload,\n    currentStatusName: currentStatus.name,\n    currentStatusId: currentStatus.id,\n    alreadyReview: isReviewName(currentStatus.name),\n    transitionId: match ? match.id : null,\n    transitionName: match ? match.name : null,\n    targetStatusName: match ? match.to.name : null,\n  },\n};\n"
      },
      "typeVersion": 2
