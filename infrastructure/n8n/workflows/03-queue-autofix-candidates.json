              "leftValue": "={{ $json.policyAllowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n03-policy-allowed",
      "name": "Policy Allowed?",
