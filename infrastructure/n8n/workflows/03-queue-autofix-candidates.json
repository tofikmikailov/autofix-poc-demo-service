    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claim = $('Claim AGENT_PENDING Job').first().json;\nconst response = $('Fetch Ticket Context').first().json;\nconst attempt = claim.agentAttemptCount;\n\nconst backoffByAttempt = { 1: '1 minute', 2: '5 minutes', 3: '15 minutes' };\nconst backoff = backoffByAttempt[attempt] || null;\nconst terminal = attempt >= 3;\n\nconst statusCode = response.statusCode;\nconst reason = `TICKET_CONTEXT_FETCH_FAILED: workflow 05 responded HTTP ${statusCode} (attempt ${attempt})`;\n\nreturn {\n  json: {\n    incidentId: claim.incidentId,\n    jiraKey: claim.jiraKey,\n    terminal,\n    backoff,\n    reason,\n  },\n};\n"
      },
