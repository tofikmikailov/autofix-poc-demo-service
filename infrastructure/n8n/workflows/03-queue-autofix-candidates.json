    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const incident = $json;\n\nconst deniedReasons = [];\n\nif (incident.service_name !== 'autofix-demo-service') {\n  deniedReasons.push(`service_name=${incident.service_name}`);\n}\nif (incident.environment !== 'local') {\n  deniedReasons.push(`environment=${incident.environment}`);\n}\nif (!incident.jira_key) {\n  deniedReasons.push('jira_key is missing');\n}\nif (incident.exception_type !== 'java.lang.NullPointerException') {\n  deniedReasons.push(`exception_type=${incident.exception_type}`);\n}\nif (incident.sample_request_path !== '/api/customers/200/display-name') {\n  deniedReasons.push(`sample_request_path=${incident.sample_request_path}`);\n}\nif (!(incident.application_stack_frame || '').includes('com.example.autofixdemo')) {\n  deniedReasons.push('application_stack_frame does not contain com.example.autofixdemo');\n}\nif (incident.agent_attempt_count >= 3) {\n  deniedReasons.push(`agent_attempt_count=${incident.agent_attempt_count}`);\n}\n\nconst allowed = deniedReasons.length === 0;\n\nreturn {\n  json: {\n    ...incident,\n    policyAllowed: allowed,\n    policyReason: allowed\n      ? 'ALLOWED: matches Stage 5C policy gate allow-list'\n      : `POLICY_REJECTED: ${deniedReasons.join('; ')}`,\n    branchName: `autofix/${incident.jira_key}`,\n  },\n};\n"
      },
