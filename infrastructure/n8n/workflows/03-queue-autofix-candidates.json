        "query": "UPDATE autofix.incident\nSET status = 'AGENT_PENDING',\n    agent_claimed_at = NULL,\n    agent_last_error = 'LEASE_EXPIRED: previous agent run exceeded ' || $1 || ' minute lease and was reclaimed',\n    updated_at = NOW()\nWHERE status = 'AGENT_RUNNING'\n  AND agent_claimed_at < NOW() - ($1 || ' minutes')::interval\nRETURNING id;",
