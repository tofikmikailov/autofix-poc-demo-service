    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH candidate AS (\n    SELECT id\n    FROM autofix.incident\n    WHERE status = 'JIRA_CREATED'\n      AND jira_key IS NOT NULL\n      AND branch_name IS NULL\n    ORDER BY created_at ASC\n    FOR UPDATE SKIP LOCKED\n    LIMIT 1\n)\nUPDATE autofix.incident AS incident\nSET\n    status = 'AGENT_PENDING',\n    updated_at = NOW()\nFROM candidate\nWHERE incident.id = candidate.id\nRETURNING\n    incident.id,\n    incident.jira_key,\n    incident.service_name,\n    incident.environment,\n    incident.exception_type,\n    incident.sample_request_path,\n    incident.application_stack_frame,\n    incident.agent_attempt_count,\n    incident.status;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "n03-select-incident",
      "name": "Select JIRA_CREATED Incident",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -960,
        288
      ],
      "alwaysOutputData": false,
      "credentials": {
        "postgres": {
          "id": "TR5zuiuRo771ypgT",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
