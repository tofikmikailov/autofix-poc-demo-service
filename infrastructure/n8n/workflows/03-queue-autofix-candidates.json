        "jsCode": "const claim = $('Claim AGENT_PENDING Job').first().json;\nconst ctx = $json.body || $json;\nconst ticket = ctx.ticket || {};\nconst incident = ctx.incident || {};\n\nconst ticketContext = {\n  summary: ticket.summary || '',\n  service: incident.service || '',\n  environment: incident.environment || '',\n  exceptionType: incident.exceptionType || '',\n  normalizedMessage: incident.normalizedMessage || '',\n  applicationFrame: incident.applicationFrame || '',\n  httpMethod: incident.httpMethod || '',\n  requestPath: incident.requestPath || '',\n  stackTrace: incident.stackTrace || '',\n  approvedAgentContext: ctx.approvedAgentContext || [],\n};\n\nreturn {\n  json: {\n    schemaVersion: 1,\n    jobId: claim.jobId,\n    incidentId: Number(claim.incidentId),\n    jiraKey: claim.jiraKey,\n    fingerprint: claim.fingerprint,\n    branchName: claim.branchName,\n    contextHash: ctx.contextHash,\n    ticketContext,\n  },\n};\n"
      },
